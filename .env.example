# Aeries SIS SDK environment example

# Base URL for the Aeries instance you want to call.
AERIES_BASE_URL=https://your-aeries-host.example/aeries/api

# Certificate value used by the Aeries API request headers.
AERIES_CERT=replace-with-your-certificate

# Optional metadata that makes local docs and tests easier to understand.
AERIES_DATABASE_YEAR=2025
AERIES_USER_AGENT=aeries-sis-sdk-golang/0.1.0
